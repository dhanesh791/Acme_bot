# Optional. Without this key the app uses local semantic embeddings (FastEmbed) with
# hybrid vector+BM25 retrieval and a cross-encoder reranker, and an extractive answer
# instead of an LLM-generated one.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Embedding provider: "auto" (OpenAI if a key is set, else local FastEmbed), "hash"
# (fast deterministic bag-of-words, no download - what the test suite uses), "local"
# (force FastEmbed even with a key set), or "openai" (force OpenAI, error if no key).
EMBEDDING_PROVIDER=auto
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=256

# Retrieval pipeline: hybrid vector+BM25 search -> cosine-score threshold gate ->
# cross-encoder rerank -> MMR diversity selection.
USE_RERANKER=true
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_POOL=20
MIN_RERANK_SCORE=-6.0
RRF_K=60
MMR_LAMBDA=0.65
RETRIEVAL_TOP_K=5
MIN_RETRIEVAL_SCORE=0.12

# Answer generation: "auto" (OpenAI if a key is set, else the extractive fallback -
# unchanged default), "openai" (force, errors without a key), "local" (fully offline
# generation via a small local LLM - opt-in only, NOT auto-selected even without a key,
# since it's a ~2.8GB one-time download and noticeably slower per answer than OpenAI
# or the instant extractive fallback), or "none" (force the extractive fallback even
# with a key configured).
GENERATION_PROVIDER=auto
LOCAL_LLM_MODEL_REPO=microsoft/Phi-3.5-mini-instruct-onnx
LOCAL_LLM_MODEL_VARIANT=cpu_and_mobile/cpu-int4-awq-block-128-acc-level-4
LOCAL_LLM_MAX_NEW_TOKENS=300

MAX_UPLOAD_MB=25
CHUNK_ROWS=6
CHUNK_MAX_CHARS=2200
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_RETRIES=3
SESSION_RETENTION_HOURS=24
